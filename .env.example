# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Kenya Construction SaaS (Turborepo + Fastify + React PWA + PostgreSQL)
# RULE: NEVER commit actual secrets, keys, or passwords to git.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
# db_migrator: Table owner role, used exclusively during migrations (CI / deploy)
MIGRATION_DATABASE_URL=postgresql://db_migrator:replace_with_migrator_password@localhost:5432/construction_db?schema=public

# db_app: Runtime non-owner, non-BYPASSRLS role used by Fastify API
DATABASE_URL=postgresql://db_app:replace_with_runtime_password@localhost:5432/construction_db?schema=public

# Authentication & Session Security
JWT_ACCESS_SECRET=replace_with_random_64_byte_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_random_64_byte_hex_string_for_refresh_tokens
COOKIE_SECRET=replace_with_random_64_byte_hex_string_for_fastify_cookie
SESSION_EXPIRY_SECONDS=900
REFRESH_EXPIRY_DAYS=7

# Object Storage (S3-compatible, e.g. Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=construction-site-evidence-dev
STORAGE_ACCESS_KEY_ID=replace_with_storage_access_key
STORAGE_SECRET_ACCESS_KEY=replace_with_storage_secret_key
STORAGE_SIGNED_URL_EXPIRY_SECONDS=300

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Safaricom Daraja 2.0 M-Pesa Subscription Billing (Milestone M22)
MPESA_ENVIRONMENT=sandbox
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=replace_with_daraja_sandbox_passkey
MPESA_WEBHOOK_SECRET=replace_with_daraja_webhook_shared_secret
MPESA_CONSUMER_KEY=replace_with_daraja_consumer_key
MPESA_CONSUMER_SECRET=replace_with_daraja_consumer_secret
MPESA_CALLBACK_URL=http://localhost:4000/api/v1/billing/mpesa-callback

# Twilio / Africa's Talking WhatsApp & SMS Gateway (Milestone M20)
SITE_OPS_WEBHOOK_SECRET=replace_with_site_ops_webhook_shared_secret
TWILIO_ACCOUNT_SID=replace_with_twilio_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# KRA e-TIMS Electronic Invoicing Sandbox (Milestone M19)
KRA_ETIMS_ENDPOINT=https://timsvscu.kra.go.ke
KRA_ETIMS_PIN=P000000000X_SANDBOX_DUMMY
KRA_ETIMS_DEVICE_SERIAL=VSCU-KENYA-DEV-001

# IoT Plant Telematics & CANBUS Flow Meters (Milestone M24)
TELEMATICS_SHARED_SECRET=replace_with_telematics_shared_secret

# --- Outbound integrations (optional — unconfigured = simulated delivery) ---
# WhatsApp Business (Meta Cloud API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Africa's Talking SMS
# AT_API_KEY=
# AT_USERNAME=sandbox
# AT_SENDER_ID=
# Resend email
# RESEND_API_KEY=
# EMAIL_FROM="Site Safi <notifications@example.com>"
# KRA eTIMS VSCU (live only — sandbox stays simulated)
# ETIMS_VSCU_PIN=
# ETIMS_VSCU_PASSWORD=
# ETIMS_ENVIRONMENT=sandbox
