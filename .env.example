# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Kenya Construction SaaS (Turborepo + Fastify + React PWA + PostgreSQL)
# RULE: NEVER commit actual secrets, keys, or passwords to git.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
# db_migrator: Table owner role, used exclusively during migrations (CI / deploy)
MIGRATION_DATABASE_URL=postgresql://db_migrator:replace_with_migrator_password@localhost:5432/construction_db?schema=public

# db_app: Runtime non-owner, non-BYPASSRLS role used by Fastify API
DATABASE_URL=postgresql://db_app:replace_with_runtime_password@localhost:5432/construction_db?schema=public

# Authentication & Session Security
JWT_ACCESS_SECRET=replace_with_random_64_byte_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_random_64_byte_hex_string_for_refresh_tokens
COOKIE_SECRET=replace_with_random_64_byte_hex_string_for_fastify_cookie
SESSION_EXPIRY_SECONDS=900
REFRESH_EXPIRY_DAYS=7

# Object Storage (S3-compatible, e.g. Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=construction-site-evidence-dev
STORAGE_ACCESS_KEY_ID=replace_with_storage_access_key
STORAGE_SECRET_ACCESS_KEY=replace_with_storage_secret_key
STORAGE_SIGNED_URL_EXPIRY_SECONDS=300

# Observability
SENTRY_DSN=
LOG_LEVEL=info
