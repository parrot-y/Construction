// -------------------------------------------------------------
// QUOTES — quotes-to-cash (ADR-007, Gate-4 slice S1)
// -------------------------------------------------------------

model Quote {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  quote_no        Int
  title           String    @db.VarChar(255)
  client_name     String    @db.VarChar(255)
  client_email    String?   @db.VarChar(255)
  client_phone    String?   @db.VarChar(50)
  site_location   String?   @db.VarChar(255)
  project_id      String?   @db.Uuid
  currency        String    @default("KES") @db.VarChar(3)
  status          String    @default("DRAFT") @db.VarChar(20) // "DRAFT","SENT","ACCEPTED","DECLINED","EXPIRED","CONVERTED"
  subtotal        Decimal   @default(0) @db.Decimal(15, 2)
  tax_pct         Decimal   @default(0) @db.Decimal(5, 2)
  tax_amount      Decimal   @default(0) @db.Decimal(15, 2)
  total           Decimal   @default(0) @db.Decimal(15, 2)
  deposit_pct     Decimal   @default(0) @db.Decimal(5, 2)
  deposit_amount  Decimal   @default(0) @db.Decimal(15, 2)
  terms           String?   @db.Text
  scope_notes     String?   @db.Text
  valid_until     DateTime? @db.Date
  share_token_hash String?  @unique @db.VarChar(64) // SHA-256 hex of the public share token; raw token shown once at send
  responded_at    DateTime? @db.Timestamptz
  responded_by    String?   @db.VarChar(255) // typed-name e-signature
  response_note   String?   @db.Text
  converted_project_id String? @db.Uuid
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  tenant          Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  items           QuoteLineItem[]
  events          QuoteEvent[]
  invoices        Invoice[]

  @@unique([tenant_id, quote_no])
  @@index([tenant_id, status])
  @@index([tenant_id, client_email])
  @@map("quotes")
}

model QuoteLineItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  quote_id       String   @db.Uuid
  section        String?  @db.VarChar(120)
  description    String   @db.Text
  unit           String   @default("item") @db.VarChar(20) // item,sum,m,m2,m3,no,kg,day,hr,lot
  quantity       Decimal  @default(1) @db.Decimal(12, 4)
  unit_rate      Decimal  @default(0) @db.Decimal(15, 4)
  total_amount   Decimal  @default(0) @db.Decimal(15, 2)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz

  quote          Quote    @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, quote_id])
  @@map("quote_line_items")
}

model QuoteEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  quote_id    String   @db.Uuid
  actor_type  String   @db.VarChar(20) // "STAFF","CLIENT","SYSTEM"
  actor_name  String?  @db.VarChar(255)
  event       String   @db.VarChar(40) // CREATED,SENT,VIEWED,ACCEPTED,DECLINED,COMMENT,CONVERTED,EXPIRED
  note        String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz

  quote       Quote    @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, quote_id])
  @@map("quote_events")
}

// INVOICES — accounts receivable (Gate-4 slice S2)
// Statuses stored: DRAFT, SENT, PART_PAID, PAID, VOID.
// OVERDUE is derived at read time (SENT/PART_PAID past due_date) — no cron needed.
model Invoice {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  invoice_no   Int
  title        String    @db.VarChar(255)
  project_id   String?   @db.Uuid
  quote_id     String?   @db.Uuid
  client_name  String    @db.VarChar(255)
  client_email String?   @db.VarChar(255)
  client_phone String?   @db.VarChar(50)
  bill_to      String?   @db.Text
  po_number    String?   @db.VarChar(100)
  status       String    @default("DRAFT") @db.VarChar(20)
  currency     String    @default("KES") @db.VarChar(3)
  subtotal     Decimal   @default(0) @db.Decimal(15, 2)
  tax_pct      Decimal   @default(0) @db.Decimal(5, 2)
  tax_amount   Decimal   @default(0) @db.Decimal(15, 2)
  total        Decimal   @default(0) @db.Decimal(15, 2)
  amount_paid  Decimal   @default(0) @db.Decimal(15, 2)
  balance_due  Decimal   @default(0) @db.Decimal(15, 2)
  issue_date   DateTime  @db.Date
  due_date     DateTime  @db.Date
  terms        String?   @db.Text
  notes        String?   @db.Text
  paybill      String?   @db.VarChar(20) // M-Pesa Paybill/Till for client remittance
  sent_at      DateTime? @db.Timestamptz
  paid_at      DateTime? @db.Timestamptz
  voided_at    DateTime? @db.Timestamptz
  void_reason  String?   @db.VarChar(255)
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project  Project?          @relation(fields: [project_id], references: [id], onDelete: SetNull)
  quote    Quote?            @relation(fields: [quote_id], references: [id], onDelete: SetNull)
  items    InvoiceLineItem[]
  payments InvoicePayment[]

  @@unique([tenant_id, invoice_no])
  @@index([tenant_id, status])
  @@index([tenant_id, project_id])
  @@index([tenant_id, due_date])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  invoice_id   String   @db.Uuid
  section      String?  @db.VarChar(120)
  description  String   @db.Text
  unit         String   @default("item") @db.VarChar(20)
  quantity     Decimal  @default(1) @db.Decimal(12, 4)
  unit_rate    Decimal  @default(0) @db.Decimal(15, 4)
  total_amount Decimal  @default(0) @db.Decimal(15, 2)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz

  invoice      Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, invoice_id])
  @@map("invoice_line_items")
}

model InvoicePayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  invoice_id  String   @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  method      String   @default("BANK") @db.VarChar(20) // "CASH","BANK","M_PESA","CHEQUE","CARD","OTHER"
  reference   String?  @db.VarChar(100) // M-Pesa transaction code, cheque no, etc.
  paid_at     DateTime @default(now()) @db.Timestamptz
  note        String?  @db.Text
  recorded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz

  invoice     Invoice   @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, invoice_id])
  @@map("invoice_payments")
}

// -------------------------------------------------------------
// PAYMENT CERTIFICATES & CLOSEOUT (ADR-008, Gate-4 S4)
// Unified interim payment certificate / payment application record.
// Status machine: DRAFT -> SUBMITTED -> UNDER_REVIEW -> CERTIFIED -> PAID
//                                    \-> REJECTED (from SUBMITTED/UNDER_REVIEW)
// -------------------------------------------------------------

model PaymentCertificate {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  project_id           String    @db.Uuid
  certificate_no       Int       // Sequential per project (IPC-<project>-NN)
  period_start         DateTime  @db.Date
  period_end           DateTime  @db.Date
  this_period_amount   Decimal   @db.Decimal(15, 2) // Gross amount certified this period
  previous_certified   Decimal   @db.Decimal(15, 2) // Certified total before this certificate
  cumulative_certified Decimal   @db.Decimal(15, 2) // previous + this period
  retention_pct        Decimal   @default(5.00) @db.Decimal(5, 2)
  retention_deduction  Decimal   @db.Decimal(15, 2) // Retention withheld this period
  retention_held       Decimal   @db.Decimal(15, 2) // Cumulative retention held after this cert
  retention_released   Decimal   @default(0) @db.Decimal(15, 2) // Moiety/defects release added back to payable
  advance_recovery     Decimal   @default(0) @db.Decimal(15, 2)
  amount_due_previous  Decimal   @default(0) @db.Decimal(15, 2)
  net_payable          Decimal   @db.Decimal(15, 2)
  status               String    @default("DRAFT") @db.VarChar(30)
  submitted_at         DateTime? @db.Timestamptz
  certified_at         DateTime? @db.Timestamptz
  paid_at              DateTime? @db.Timestamptz
  paid_reference       String?   @db.VarChar(100) // M-Pesa code / EFT ref / cheque no
  submitted_by_id      String?   @db.Uuid
  certified_by_id      String?   @db.Uuid
  notes                String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  project              Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, certificate_no])
  @@index([tenant_id, project_id, status])
  @@map("payment_certificates")
}

// -------------------------------------------------------------
// COMMITMENTS -> CLAIMS -> PAYMENT APPLICATIONS (Gate-4 S5)
// Vendor-agnostic commitment ledger (subcontractors, suppliers,
// consultants) with periodic payment applications, retention and
// advance-recovery math in Decimal.
// -------------------------------------------------------------

model Commitment {
  id                     String    @id @default(uuid()) @db.Uuid
  tenant_id              String    @db.Uuid
  project_id             String    @db.Uuid
  commitment_no          Int       // Sequential per project
  vendor_name            String    @db.VarChar(255)
  vendor_type            String    @default("SUBCONTRACTOR") @db.VarChar(30) // "SUBCONTRACTOR","SUPPLIER","CONSULTANT","OTHER"
  scope_description      String?   @db.Text
  contract_value         Decimal   @db.Decimal(15, 2)
  currency               String    @default("KES") @db.VarChar(3)
  retention_pct          Decimal   @default(5.00) @db.Decimal(5, 2)
  retention_cap_pct      Decimal   @default(5.00) @db.Decimal(5, 2) // Cap as % of contract value (JBC-style)
  advance_amount         Decimal   @default(0) @db.Decimal(15, 2)
  advance_paid           Decimal   @default(0) @db.Decimal(15, 2)
  advance_recover_pct    Decimal   @default(0) @db.Decimal(5, 2) // % of each gross claim recovered until advance cleared
  cost_code              String?   @db.VarChar(50)
  status                 String    @default("ACTIVE") @db.VarChar(20) // "DRAFT","ACTIVE","COMPLETED","TERMINATED"
  subcontractor_package_id String? @db.Uuid
  notes                  String?   @db.Text
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @updatedAt @db.Timestamptz

  project                Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  applications           PaymentApplication[]

  @@unique([project_id, commitment_no])
  @@index([tenant_id, project_id, status])
  @@map("commitments")
}

model PaymentApplication {
  id                     String    @id @default(uuid()) @db.Uuid
  tenant_id              String    @db.Uuid
  project_id             String    @db.Uuid
  commitment_id          String    @db.Uuid
  application_no         Int       // Sequential per commitment
  period_start           DateTime  @db.Date
  period_end             DateTime  @db.Date
  gross_claimed          Decimal   @db.Decimal(15, 2)
  previous_certified     Decimal   @db.Decimal(15, 2) // Gross certified on prior APPROVED/PAID applications
  cumulative_certified   Decimal   @db.Decimal(15, 2)
  retention_withheld     Decimal   @db.Decimal(15, 2) // This application
  retention_held         Decimal   @db.Decimal(15, 2) // Cumulative held after this application
  advance_recovered      Decimal   @db.Decimal(15, 2) // This application
  advance_outstanding    Decimal   @db.Decimal(15, 2) // Remaining advance after this application
  wht_pct                Decimal   @default(0) @db.Decimal(5, 2) // Kenyan WHT (e.g. 3% subcontractors)
  wht_amount             Decimal   @default(0) @db.Decimal(15, 2)
  previous_balance       Decimal   @default(0) @db.Decimal(15, 2) // Carried amount due from prior applications
  net_payable            Decimal   @db.Decimal(15, 2)
  status                 String    @default("DRAFT") @db.VarChar(20) // "DRAFT","SUBMITTED","APPROVED","PAID","REJECTED"
  submitted_at           DateTime? @db.Timestamptz
  approved_at            DateTime? @db.Timestamptz
  paid_at                DateTime? @db.Timestamptz
  paid_reference         String?   @db.VarChar(100)
  submitted_by_id        String?   @db.Uuid
  approved_by_id         String?   @db.Uuid
  notes                  String?   @db.Text
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @updatedAt @db.Timestamptz

  project                Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  commitment             Commitment @relation(fields: [commitment_id], references: [id], onDelete: Cascade)

  @@unique([commitment_id, application_no])
  @@index([tenant_id, project_id, status])
  @@map("payment_applications")
}

model SnagComment {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  snag_item_id  String   @db.Uuid
  author_name   String   @db.VarChar(255)
  body          String   @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz

  snag_item     SnagItem @relation(fields: [snag_item_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, snag_item_id])
  @@map("snag_comments")
}

model SnagDistribution {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  snag_item_id      String   @db.Uuid
  recipient_name    String   @db.VarChar(255)
  recipient_contact String?  @db.VarChar(255) // email / phone / role
  channel           String?  @db.VarChar(30)  // "EMAIL","SMS","WHATSAPP","IN_APP"
  created_at        DateTime @default(now()) @db.Timestamptz

  snag_item         SnagItem @relation(fields: [snag_item_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, snag_item_id])
  @@map("snag_distributions")
}

// -------------------------------------------------------------
// ANNOUNCEMENTS (Gate-5 G5-1): audience-targeted broadcasts with
// read acknowledgement receipts.
// -------------------------------------------------------------

model Announcement {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String?   @db.Uuid // optional project scoping
  title           String    @db.VarChar(255)
  body            String    @db.Text
  priority        String    @default("NORMAL") @db.VarChar(10) // "LOW","NORMAL","HIGH","URGENT"
  audience        String    @default("ALL") @db.VarChar(20) // "ALL","INTERNAL","CLIENTS","FIELD_TEAM"
  target_roles    String[]  @default([]) // role-scoped targeting (tenant roles)
  status          String    @default("PUBLISHED") @db.VarChar(15) // "DRAFT","PUBLISHED","ARCHIVED"
  published_at    DateTime? @db.Timestamptz
  expires_at      DateTime? @db.Timestamptz
  created_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  reads           AnnouncementRead[]

  @@index([tenant_id, status, published_at])
  @@map("announcements")
}

model AnnouncementRead {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  announcement_id String   @db.Uuid
  user_id         String   @db.Uuid
  read_at         DateTime @default(now()) @db.Timestamptz

  announcement    Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)

  @@unique([announcement_id, user_id])
  @@index([tenant_id, announcement_id])
  @@map("announcement_reads")
}

// -------------------------------------------------------------
// INBOX (Gate-5 G5-3): team messaging observed as Home > Inbox
// for all field-capable roles. Project-scoped or tenant-wide,
// role-targeted, threaded replies, read receipts.
// -------------------------------------------------------------

model InboxMessage {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String?   @db.Uuid
  sender_id       String    @db.Uuid
  sender_name     String    @db.VarChar(255)
  body            String    @db.Text
  audience        String    @default("PROJECT_TEAM") @db.VarChar(20) // "ALL_MEMBERS","PROJECT_TEAM","ROLE"
  target_roles    String[]  @default([])
  parent_id       String?   @db.Uuid // thread reply
  created_at      DateTime  @default(now()) @db.Timestamptz

  project         Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  reads           InboxMessageRead[]

  @@index([tenant_id, project_id, created_at])
  @@map("inbox_messages")
}

model InboxMessageRead {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  message_id      String   @db.Uuid
  user_id         String   @db.Uuid
  read_at         DateTime @default(now()) @db.Timestamptz

  message         InboxMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@index([tenant_id, message_id])
  @@map("inbox_message_reads")
}

// -------------------------------------------------------------
// OBSERVATIONS & CORRECTIVE ACTIONS (Gate-5 G5-4): observed Site >
// Observations / Action plans. Observation raised during walks/
// inspections; corrective actions link back via source ref.
// -------------------------------------------------------------

model SiteObservation {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String    @db.Uuid
  obs_number      Int       // Sequential per project (OBS-001…)
  title           String    @db.VarChar(255)
  type            String    @default("QUALITY") @db.VarChar(20) // "QUALITY","SAFETY","ENVIRONMENTAL","COMMISSIONING"
  priority        String    @default("MEDIUM") @db.VarChar(10) // "LOW","MEDIUM","HIGH"
  location        String?   @db.VarChar(255) // e.g. "Level 2 — Grid C4"
  description     String    @db.Text
  status          String    @default("OPEN") @db.VarChar(15) // "OPEN","IN_REVIEW","CLOSED"
  raised_by_id    String?   @db.Uuid
  raised_by_name  String    @db.VarChar(255)
  closed_at       DateTime? @db.Timestamptz
  closed_by_name  String?   @db.VarChar(255)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  corrective_actions CorrectiveAction[]

  @@unique([project_id, obs_number])
  @@index([tenant_id, project_id, status])
  @@map("site_observations")
}

model CorrectiveAction {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String    @db.Uuid
  observation_id  String?   @db.Uuid
  title           String    @db.VarChar(255)
  owner_name      String    @db.VarChar(255)
  due_date        DateTime? @db.Date
  source_ref      String?   @db.VarChar(50) // e.g. "OBS-003" or external ref
  steps           String[]  @default([]) // ordered action steps
  status          String    @default("ACTIVE") @db.VarChar(15) // "ACTIVE","COMPLETED"
  completed_at    DateTime? @db.Timestamptz
  created_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  observation     SiteObservation? @relation(fields: [observation_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, project_id, status])
  @@map("corrective_actions")
}

// -------------------------------------------------------------
// CREWS (Gate-5 G5-5): observed People > Crews — named trade crews
// with foreman + members, optionally project-assigned.
// -------------------------------------------------------------

model Crew {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String?   @db.Uuid
  name            String    @db.VarChar(255) // e.g. "Masonry Crew A"
  trade           String    @db.VarChar(100) // "Masonry","Electrical","Plumbing"…
  foreman_name    String?   @db.VarChar(255)
  status          String    @default("ACTIVE") @db.VarChar(15) // "ACTIVE","INACTIVE"
  notes           String?   @db.Text
  created_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project?  @relation(fields: [project_id], references: [id], onDelete: SetNull)
  members         CrewMember[]
  attendances     DailyAttendance[]

  @@index([tenant_id, project_id, status])
  @@map("crews")
}

model CrewMember {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  crew_id         String    @db.Uuid
  name            String    @db.VarChar(255)
  trade           String?   @db.VarChar(100)
  phone           String?   @db.VarChar(50)
  daily_rate_kes  Decimal?  @db.Decimal(12, 2)
  created_at      DateTime  @default(now()) @db.Timestamptz

  crew            Crew      @relation(fields: [crew_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, crew_id])
  @@map("crew_members")
}

// -------------------------------------------------------------
// COMPANY DOCUMENTS VAULT (Gate-5 G5-7): observed Files & reports >
// Company documents — tenant-level vault with categories
// (Policies/Templates/Certifications/Insurance/HR/Legal), expiry
// tracking, and "Unfiled documents" triage (category null until
// filed). Distinct from project-scoped ProjectDocument.
// -------------------------------------------------------------

model CompanyDocument {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  title           String    @db.VarChar(255)
  category        String?   @db.VarChar(30) // null = UNFILED; "POLICY","TEMPLATE","CERTIFICATION","INSURANCE","HR","LEGAL","OTHER"
  reference_no    String?   @db.VarChar(100) // e.g. NCA cert no., policy no.
  file_name       String?   @db.VarChar(255)
  mime_type       String?   @db.VarChar(100)
  file_size       Int?
  storage_key     String?   @db.VarChar(500)
  expiry_date     DateTime? @db.Date
  status          String    @default("ACTIVE") @db.VarChar(15) // "ACTIVE","ARCHIVED"
  uploaded_by_id  String?   @db.Uuid
  uploaded_by_name String   @db.VarChar(255)
  notes           String?   @db.Text
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  @@index([tenant_id, category, status])
  @@index([tenant_id, expiry_date])
  @@map("company_documents")
}

// -------------------------------------------------------------
// CORRESPONDENCE LOG (Gate-5 G5-8): observed Projects >
// Correspondence — formal project letters: Letter, Submittal,
// Transmittal, Notice. Sequential per project, direction-aware.
// -------------------------------------------------------------

model CorrespondenceItem {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String    @db.Uuid
  corr_number     Int       // sequential per project → COR-001…
  type            String    @db.VarChar(20) // "LETTER","SUBMITTAL","TRANSMITTAL","NOTICE"
  direction       String    @default("OUTGOING") @db.VarChar(10) // "OUTGOING","INCOMING"
  subject         String    @db.VarChar(500)
  from_name       String    @db.VarChar(255)
  to_name         String    @db.VarChar(255)
  reference       String?   @db.VarChar(100) // e.g. "VO/2026/014", consultant ref
  letter_date     DateTime? @db.Date
  status          String    @default("DRAFT") @db.VarChar(15) // "DRAFT","SENT","RECEIVED","RESPONDED","FILED"
  body            String?   @db.Text
  attachment_name String?   @db.VarChar(255)
  created_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, corr_number])
  @@index([tenant_id, project_id, type])
  @@map("correspondence_items")
}

// -------------------------------------------------------------
// SCHEDULED REPORTS (Gate-5 G5-9): observed Files & reports >
// Scheduled — saved report definitions with frequency, recipient
// list, project scope, and run history. Generation snapshots a
// tenant summary into ScheduledReportRun; external delivery is a
// later integration.
// -------------------------------------------------------------

model ScheduledReport {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String?   @db.Uuid
  name            String    @db.VarChar(255)
  report_type     String    @db.VarChar(20) // "FINANCIAL","OPERATIONAL","BY_PROJECT","BY_REGION","CUSTOM"
  frequency       String    @db.VarChar(10) // "DAILY","WEEKLY","MONTHLY"
  day_of_week     Int?      // 0=Sun…6=Sat (WEEKLY)
  day_of_month    Int?      // 1-28 (MONTHLY)
  recipients      String[]  @default([]) // emails or role labels
  format          String    @default("PDF") @db.VarChar(10) // "PDF","EXCEL","JSON"
  status          String    @default("ACTIVE") @db.VarChar(10) // "ACTIVE","PAUSED"
  next_run_at     DateTime? @db.Timestamptz
  last_run_at     DateTime? @db.Timestamptz
  created_by_id   String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  runs            ScheduledReportRun[]

  @@index([tenant_id, status, next_run_at])
  @@map("scheduled_reports")
}

model ScheduledReportRun {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  report_id       String    @db.Uuid
  ran_at          DateTime  @default(now()) @db.Timestamptz
  status          String    @db.VarChar(10) // "SUCCESS","FAILED"
  summary         Json?     // snapshot payload
  error           String?   @db.Text

  report          ScheduledReport @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, report_id, ran_at])
  @@map("scheduled_report_runs")
}

// -------------------------------------------------------------
// DAILY ATTENDANCE (Gate-5 G5-10): observed Site > Attendance —
// Today / History / Check In / Report Leave or Off-Day.
// Per-laborer per-project per-day register; distinct from payroll
// LaborDailyAttendance (weekly muster) and geofenced
// WorkerClockEvent (IoT). Optional crew link.
// -------------------------------------------------------------

model DailyAttendance {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  project_id      String    @db.Uuid
  laborer_id      String    @db.Uuid
  crew_id         String?   @db.Uuid
  work_date       DateTime  @db.Date
  status          String    @default("PRESENT") @db.VarChar(15) // "PRESENT","HALF_DAY","LEAVE","OFF_DAY","ABSENT"
  check_in_at     DateTime? @db.Timestamptz
  check_out_at    DateTime? @db.Timestamptz
  hours_worked    Decimal?  @db.Decimal(4, 2)
  notes           String?   @db.Text
  recorded_by_id  String?   @db.Uuid
  recorded_by_name String?  @db.VarChar(255)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  laborer         SiteLaborer @relation(fields: [laborer_id], references: [id], onDelete: Cascade)
  crew            Crew?     @relation(fields: [crew_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, project_id, laborer_id, work_date])
  @@index([tenant_id, project_id, work_date])
  @@map("daily_attendances")
}
