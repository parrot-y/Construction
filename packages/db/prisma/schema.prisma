datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// TENANCY & IDENTITY
// -------------------------------------------------------------

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(255)
  slug           String       @unique @db.VarChar(100)
  kra_pin        String?      @db.VarChar(20)
  nca_category   String?      @db.VarChar(50) // e.g. "NCA 4"
  currency       String       @default("KES") @db.VarChar(3)
  created_at     DateTime     @default(now()) @db.Timestamptz
  updated_at     DateTime     @updatedAt @db.Timestamptz

  memberships    Membership[]
  invitations    Invitation[]
  projects       Project[]
  idempotency    IdempotencyKey[]
  audit_logs     AuditLog[]

  @@map("tenants")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique @db.VarChar(255)
  password_hash  String       @db.VarChar(255)
  full_name      String       @db.VarChar(255)
  phone_number   String?      @db.VarChar(30)
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now()) @db.Timestamptz
  updated_at     DateTime     @updatedAt @db.Timestamptz

  memberships    Membership[]
  project_members ProjectMember[]
  cost_entries   CostEntry[]  @relation("CostCreator")
  cost_approvals CostApproval[]
  rfis_created   RFI[]        @relation("RfiAuthor")
  rfi_responses  RFIResponse[]

  @@map("users")
}

model Membership {
  id         String     @id @default(uuid()) @db.Uuid
  tenant_id  String     @db.Uuid
  user_id    String     @db.Uuid
  role       String     @db.VarChar(50) // "ADMIN", "PM_QS", "SITE_SUPERVISOR", "CLIENT"
  created_at DateTime   @default(now()) @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id])
  @@map("memberships")
}

model Invitation {
  id         String     @id @default(uuid()) @db.Uuid
  tenant_id  String     @db.Uuid
  email      String     @db.VarChar(255)
  phone      String?    @db.VarChar(30)
  role       String     @db.VarChar(50) // "COMPANY_ADMIN", "PM_QS", "SITE_SUPERVISOR", "CLIENT"
  token      String     @unique @db.VarChar(255)
  status     String     @default("PENDING") @db.VarChar(50) // "PENDING", "ACCEPTED", "EXPIRED", "REVOKED"
  expires_at DateTime   @db.Timestamptz
  created_at DateTime   @default(now()) @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
  @@map("invitations")
}

// -------------------------------------------------------------
// PROJECTS
// -------------------------------------------------------------

model Project {
  id                   String          @id @default(uuid()) @db.Uuid
  tenant_id            String          @db.Uuid
  name                 String          @db.VarChar(255)
  code                 String          @db.VarChar(50)
  description          String?         @db.Text
  location             String?         @db.VarChar(255)
  nca_project_no       String?         @db.VarChar(100) // NCA Project Registration ID
  status               String          @default("ACTIVE") @db.VarChar(50) // "PLANNING", "ACTIVE", "COMPLETED", "ON_HOLD"
  original_contract_sum Decimal        @default(0.00) @db.Decimal(15, 2)
  current_approved_budget Decimal      @default(0.00) @db.Decimal(15, 2)
  start_date           DateTime?       @db.Date
  target_end_date      DateTime?       @db.Date
  created_at           DateTime        @default(now()) @db.Timestamptz
  updated_at           DateTime        @updatedAt @db.Timestamptz

  tenant               Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  members              ProjectMember[]
  boqs                 BOQ[]
  cost_entries         CostEntry[]
  site_diaries         SiteDiary[]
  progress_records     ProgressRecord[]
  variation_orders     VariationOrder[]
  rfis                 RFI[]
  inspection_checklists InspectionChecklist[]
  concrete_cube_tests  ConcreteCubeTest[]
  snag_items           SnagItem[]
  defects_liability_certificates DefectsLiabilityCertificate[]
  portal_access_links  PortalAccessLink[]
  schedule_tasks       ProjectScheduleTask[]
  inventory_items      SiteInventoryItem[]
  inventory_movements  InventoryMovement[]
  safety_incidents     SafetyIncident[]
  documents            ProjectDocument[]
  subcontractor_packages SubcontractorPackage[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status])
  @@map("projects")
}

model ProjectMember {
  id         String     @id @default(uuid()) @db.Uuid
  tenant_id  String     @db.Uuid
  project_id String     @db.Uuid
  user_id    String     @db.Uuid
  role       String     @db.VarChar(50) // Project-scoped role assignment
  created_at DateTime   @default(now()) @db.Timestamptz

  project    Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([tenant_id, project_id])
  @@map("project_members")
}

// -------------------------------------------------------------
// BOQ & BUDGET BASELINE
// -------------------------------------------------------------

model BOQ {
  id             String       @id @default(uuid()) @db.Uuid
  tenant_id      String       @db.Uuid
  project_id     String       @db.Uuid
  version        Int          @default(1)
  status         String       @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "SUPERSEDED"
  source_filename String?     @db.VarChar(255)
  total_amount   Decimal      @default(0.00) @db.Decimal(15, 2)
  created_at     DateTime     @default(now()) @db.Timestamptz

  project        Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  sections       BOQSection[]

  @@unique([project_id, version])
  @@index([tenant_id, project_id])
  @@map("boqs")
}

model BOQSection {
  id         String     @id @default(uuid()) @db.Uuid
  tenant_id  String     @db.Uuid
  boq_id     String     @db.Uuid
  order_idx  Int
  title      String     @db.VarChar(255) // e.g. "Section 2: Substructure"
  total_amount Decimal  @default(0.00) @db.Decimal(15, 2)

  boq        BOQ        @relation(fields: [boq_id], references: [id], onDelete: Cascade)
  items      BOQItem[]

  @@index([tenant_id, boq_id])
  @@map("boq_sections")
}

model BOQItem {
  id             String           @id @default(uuid()) @db.Uuid
  tenant_id      String           @db.Uuid
  section_id     String           @db.Uuid
  item_code      String           @db.VarChar(50) // e.g. "A", "2.1.1"
  description    String           @db.Text
  unit           String           @db.VarChar(20) // "SM", "CM", "LM", "KG", "NO", "ITEM"
  quantity       Decimal          @db.Decimal(12, 4) // Measured net quantity
  unit_rate      Decimal          @db.Decimal(15, 4) // Rate in KES
  total_amount   Decimal          @db.Decimal(15, 2) // qty * rate
  is_provisional Boolean          @default(false)
  created_at     DateTime         @default(now()) @db.Timestamptz

  section        BOQSection       @relation(fields: [section_id], references: [id], onDelete: Cascade)
  cost_entries   CostEntry[]
  progress_items ProgressItem[]
  variation_items VariationItem[]

  @@index([tenant_id, section_id])
  @@map("boq_items")
}

// -------------------------------------------------------------
// SITE DIARY & FIELD EVIDENCE (OFFLINE-CAPABLE DOMAIN)
// -------------------------------------------------------------

model SiteDiary {
  id               String               @id @default(uuid()) @db.Uuid
  tenant_id        String               @db.Uuid
  project_id       String               @db.Uuid
  entry_date       DateTime             @db.Date
  weather          String               @db.VarChar(50) // "SUNNY", "RAIN_DELAY", "HEAVY_RAIN"
  site_status      String               @db.VarChar(50) // "OPERATIONAL", "STOPPED", "PARTIAL"
  general_notes    String?              @db.Text
  recorded_by_id   String               @db.Uuid
  created_at       DateTime             @default(now()) @db.Timestamptz

  project          Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  photos           SitePhoto[]
  labor_headcounts LaborHeadcount[]
  deliveries       MaterialDelivery[]

  @@unique([project_id, entry_date])
  @@index([tenant_id, project_id])
  @@map("site_diaries")
}

model SitePhoto {
  id             String     @id @default(uuid()) @db.Uuid
  tenant_id      String     @db.Uuid
  site_diary_id  String     @db.Uuid
  storage_key    String     @db.VarChar(500) // S3 object key
  caption        String?    @db.VarChar(255)
  taken_at       DateTime   @db.Timestamptz
  gps_latitude   Decimal?   @db.Decimal(9, 6)
  gps_longitude  Decimal?   @db.Decimal(9, 6)
  created_at     DateTime   @default(now()) @db.Timestamptz

  site_diary     SiteDiary  @relation(fields: [site_diary_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, site_diary_id])
  @@map("site_photos")
}

model LaborHeadcount {
  id            String     @id @default(uuid()) @db.Uuid
  tenant_id     String     @db.Uuid
  site_diary_id String     @db.Uuid
  trade_type    String     @db.VarChar(100) // "Mason", "Steel Fixer", "Carpenter", "Casual"
  headcount     Int        @default(1)

  site_diary    SiteDiary  @relation(fields: [site_diary_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, site_diary_id])
  @@map("labor_headcounts")
}

model MaterialDelivery {
  id            String     @id @default(uuid()) @db.Uuid
  tenant_id     String     @db.Uuid
  site_diary_id String     @db.Uuid
  material_name String     @db.VarChar(255) // e.g. "Machine-Cut Stone 9x9"
  quantity      Decimal    @db.Decimal(12, 4)
  unit          String     @db.VarChar(20)
  supplier_name String?    @db.VarChar(255)
  delivery_note String?    @db.VarChar(100)

  site_diary    SiteDiary  @relation(fields: [site_diary_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, site_diary_id])
  @@map("material_deliveries")
}

// -------------------------------------------------------------
// PHYSICAL PROGRESS RECORDING
// -------------------------------------------------------------

model ProgressRecord {
  id             String         @id @default(uuid()) @db.Uuid
  tenant_id      String         @db.Uuid
  project_id     String         @db.Uuid
  record_date    DateTime       @db.Date
  overall_progress Decimal      @db.Decimal(5, 4) // e.g. 0.4500 (45.00%)
  notes          String?        @db.Text
  created_at     DateTime       @default(now()) @db.Timestamptz

  project        Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items          ProgressItem[]

  @@index([tenant_id, project_id, record_date])
  @@map("progress_records")
}

model ProgressItem {
  id                 String         @id @default(uuid()) @db.Uuid
  tenant_id          String         @db.Uuid
  progress_record_id String         @db.Uuid
  boq_item_id        String         @db.Uuid
  completed_quantity Decimal        @db.Decimal(12, 4) // Cumulative measured quantity to date
  completion_pct     Decimal        @db.Decimal(5, 4) // e.g. 0.6000 (60.00%)

  progress_record    ProgressRecord @relation(fields: [progress_record_id], references: [id], onDelete: Cascade)
  boq_item           BOQItem        @relation(fields: [boq_item_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, progress_record_id])
  @@map("progress_items")
}

// -------------------------------------------------------------
// ACTUAL COSTS & APPROVALS (APPEND-ONLY FINANCIAL LEDGER)
// -------------------------------------------------------------

model CostEntry {
  id             String         @id @default(uuid()) @db.Uuid
  tenant_id      String         @db.Uuid
  project_id     String         @db.Uuid
  boq_item_id    String?        @db.Uuid
  cost_category  String         @db.VarChar(50) // "MATERIAL", "LABOR", "PLANT", "SUBCONTRACT", "PRELIMINARY"
  amount         Decimal        @db.Decimal(15, 2)
  vendor_name    String?        @db.VarChar(255)
  invoice_ref    String?        @db.VarChar(100)
  description    String         @db.Text
  status         String         @default("PENDING") @db.VarChar(50) // "PENDING", "APPROVED", "REJECTED", "VOIDED"
  created_by_id  String         @db.Uuid
  created_at     DateTime       @default(now()) @db.Timestamptz

  project        Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  boq_item       BOQItem?       @relation(fields: [boq_item_id], references: [id])
  created_by     User           @relation("CostCreator", fields: [created_by_id], references: [id])
  receipts       CostReceipt[]
  approvals      CostApproval[]

  @@index([tenant_id, project_id, status])
  @@map("cost_entries")
}

model CostReceipt {
  id            String     @id @default(uuid()) @db.Uuid
  tenant_id     String     @db.Uuid
  cost_entry_id String     @db.Uuid
  storage_key   String     @db.VarChar(500)
  filename      String     @db.VarChar(255)
  file_size     Int
  mime_type     String     @db.VarChar(100)
  created_at    DateTime   @default(now()) @db.Timestamptz

  cost_entry    CostEntry  @relation(fields: [cost_entry_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, cost_entry_id])
  @@map("cost_receipts")
}

model CostApproval {
  id            String     @id @default(uuid()) @db.Uuid
  tenant_id     String     @db.Uuid
  cost_entry_id String     @db.Uuid
  reviewer_id   String     @db.Uuid
  action        String     @db.VarChar(50) // "APPROVED", "REJECTED"
  comments      String?    @db.Text
  created_at    DateTime   @default(now()) @db.Timestamptz

  cost_entry    CostEntry  @relation(fields: [cost_entry_id], references: [id], onDelete: Cascade)
  reviewer      User       @relation(fields: [reviewer_id], references: [id])

  @@index([tenant_id, cost_entry_id])
  @@map("cost_approvals")
}

// -------------------------------------------------------------
// VARIATION ORDERS
// -------------------------------------------------------------

model VariationOrder {
  id                   String          @id @default(uuid()) @db.Uuid
  tenant_id            String          @db.Uuid
  project_id           String          @db.Uuid
  variation_no         Int
  title                String          @db.VarChar(255)
  reason               String          @db.Text
  status               String          @default("SUBMITTED") @db.VarChar(50) // "SUBMITTED", "QS_EVALUATED", "APPROVED", "REJECTED"
  net_amount           Decimal         @db.Decimal(15, 2) // Positive or negative
  time_extension_days  Int             @default(0)
  approved_at          DateTime?       @db.Timestamptz
  created_at           DateTime        @default(now()) @db.Timestamptz

  project              Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items                VariationItem[]

  @@unique([project_id, variation_no])
  @@index([tenant_id, project_id, status])
  @@map("variation_orders")
}

model VariationItem {
  id                 String          @id @default(uuid()) @db.Uuid
  tenant_id          String          @db.Uuid
  variation_order_id String          @db.Uuid
  boq_item_id        String?         @db.Uuid
  description        String          @db.Text
  unit               String          @db.VarChar(20)
  quantity           Decimal         @db.Decimal(12, 4) // Positive (addition) or negative (omission)
  unit_rate          Decimal         @db.Decimal(15, 4)
  total_amount       Decimal         @db.Decimal(15, 2)

  variation_order    VariationOrder  @relation(fields: [variation_order_id], references: [id], onDelete: Cascade)
  boq_item           BOQItem?        @relation(fields: [boq_item_id], references: [id])

  @@index([tenant_id, variation_order_id])
  @@map("variation_items")
}

// -------------------------------------------------------------
// AUDIT LOG & IDEMPOTENCY
// -------------------------------------------------------------

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  tenant_id   String     @db.Uuid
  project_id  String?    @db.Uuid
  actor_id    String     @db.Uuid
  action      String     @db.VarChar(100) // e.g. "COST_ENTRY_APPROVED", "BOQ_IMPORTED"
  entity_type String     @db.VarChar(100)
  entity_id   String     @db.Uuid
  changes     Json?      // Structured before/after diff
  ip_address  String?    @db.VarChar(50)
  user_agent  String?    @db.VarChar(255)
  created_at  DateTime   @default(now()) @db.Timestamptz

  tenant      Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, project_id, created_at])
  @@map("audit_logs")
}

model IdempotencyKey {
  id              String     @id @default(uuid()) @db.Uuid
  tenant_id       String     @db.Uuid
  idempotency_key String     @db.VarChar(255)
  response_status Int
  response_body   Json
  created_at      DateTime   @default(now()) @db.Timestamptz

  tenant          Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, idempotency_key])
  @@map("idempotency_keys")
}


// =============================================================
// DOMAIN EXTENSION 1: TECHNICAL QUERIES & RFIs
// =============================================================

enum RfiStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ANSWERED
  REJECTED
  CLOSED
}

enum RfiPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model RFI {
  id                  String       @id @default(uuid()) @db.Uuid
  tenant_id           String       @db.Uuid
  project_id          String       @db.Uuid
  rfi_number          Int          // Sequential per project: 1, 2, 3...
  title               String       @db.VarChar(255)
  question            String       @db.Text
  suggested_solution  String?      @db.Text
  drawing_reference   String?      @db.VarChar(100) // e.g. "STR-04 Rev C"
  specification_clause String?     @db.VarChar(100) // e.g. "EASMM Sec 3.4"
  priority            RfiPriority  @default(MEDIUM)
  status              RfiStatus    @default(SUBMITTED)
  cost_impact         Boolean      @default(false)
  schedule_impact_days Int         @default(0)
  assigned_to_role    String       @db.VarChar(50)  // "ARCHITECT", "STRUCTURAL_ENG", "SERVICES_ENG", "QS"
  created_by_id       String       @db.Uuid
  due_date            DateTime?    @db.Date
  closed_at           DateTime?    @db.Timestamptz
  created_at          DateTime     @default(now()) @db.Timestamptz
  updated_at          DateTime     @updatedAt @db.Timestamptz

  project             Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_by          User         @relation("RfiAuthor", fields: [created_by_id], references: [id])
  responses           RFIResponse[]
  attachments         RFIAttachment[]

  @@unique([project_id, rfi_number])
  @@index([tenant_id, project_id, status])
  @@map("rfis")
}

model RFIResponse {
  id              String       @id @default(uuid()) @db.Uuid
  tenant_id       String       @db.Uuid
  rfi_id          String       @db.Uuid
  responder_id    String       @db.Uuid
  official_answer String       @db.Text
  is_accepted     Boolean      @default(true)
  created_at      DateTime     @default(now()) @db.Timestamptz

  rfi             RFI          @relation(fields: [rfi_id], references: [id], onDelete: Cascade)
  responder       User         @relation(fields: [responder_id], references: [id])

  @@index([tenant_id, rfi_id])
  @@map("rfi_responses")
}

model RFIAttachment {
  id          String       @id @default(uuid()) @db.Uuid
  tenant_id   String       @db.Uuid
  rfi_id      String       @db.Uuid
  storage_key String       @db.VarChar(500)
  filename    String       @db.VarChar(255)
  file_size   Int
  mime_type   String       @db.VarChar(100)
  created_at  DateTime     @default(now()) @db.Timestamptz

  rfi         RFI          @relation(fields: [rfi_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, rfi_id])
  @@map("rfi_attachments")
}

// =============================================================
// DOMAIN EXTENSION 2: QUALITY ASSURANCE & INSPECTION CHECKLISTS
// =============================================================

enum ChecklistType {
  PRE_POUR_CONCRETE
  SUBSTRUCTURE_EXCAVATION
  REBAR_VERIFICATION
  SCAFFOLDING_SAFETY
  WATERPROOFING_FLOOD_TEST
  MEP_PRESSURE_TEST
  PRE_PLASTER_WALLING
  PRE_HANDOVER_INSPECTION
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  APPROVED_WITHOUT_COMMENTS
  APPROVED_WITH_CONDITIONS
  REJECTED
}

model InspectionChecklist {
  id              String            @id @default(uuid()) @db.Uuid
  tenant_id       String            @db.Uuid
  project_id      String            @db.Uuid
  checklist_type  ChecklistType
  title           String            @db.VarChar(255)
  location        String            @db.VarChar(255) // e.g. "Block B, 2nd Floor Slab"
  status          InspectionStatus  @default(PENDING)
  scheduled_date  DateTime          @db.Date
  inspected_at    DateTime?         @db.Timestamptz
  inspector_name  String?           @db.VarChar(255) // Consulting Engineer / Architect
  inspector_role  String?           @db.VarChar(100)
  signed_off_by_id String?          @db.Uuid
  summary_notes   String?           @db.Text
  created_at      DateTime          @default(now()) @db.Timestamptz
  updated_at      DateTime          @updatedAt @db.Timestamptz

  project         Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  items           InspectionItem[]

  @@index([tenant_id, project_id, checklist_type])
  @@map("inspection_checklists")
}

model InspectionItem {
  id                   String              @id @default(uuid()) @db.Uuid
  tenant_id            String              @db.Uuid
  checklist_id         String              @db.Uuid
  order_idx            Int
  check_point          String              @db.VarChar(255) // e.g. "Reinforcement cover blocks minimum 25mm"
  is_mandatory         Boolean             @default(true)
  result               String              @default("PENDING") @db.VarChar(20) // "PASS", "FAIL", "N/A", "PENDING"
  deficiency_notes     String?             @db.Text
  photo_storage_key    String?             @db.VarChar(500)

  checklist            InspectionChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, checklist_id])
  @@map("inspection_items")
}

// =============================================================
// DOMAIN EXTENSION 3: CONCRETE QUALITY & CUBE TEST REGISTRY
// =============================================================

enum ConcreteClass {
  CLASS_15_20 // Blinding
  CLASS_20_20 // Standard Structural (1:2:4)
  CLASS_25_20 // High-Strength Columns / Slabs
  CLASS_30_20 // Precast / Water-Retaining
  CLASS_35_20 // Specialized High-Load
}

model ConcreteCubeTest {
  id                    String            @id @default(uuid()) @db.Uuid
  tenant_id             String            @db.Uuid
  project_id            String            @db.Uuid
  batch_reference       String            @db.VarChar(100) // e.g. "POUR-2026-11-04-SLAB3"
  pour_location         String            @db.VarChar(255) // e.g. "Third Floor Slab & Beams Axis 1-6"
  pour_date             DateTime          @db.Date
  concrete_class        ConcreteClass     @default(CLASS_25_20)
  target_strength_mpa   Decimal           @db.Decimal(5, 2) // e.g. 25.00 MPa
  slump_tested_mm       Int?              // Measured slump in mm (e.g. 75mm)
  supplier_name         String?           @db.VarChar(255) // "Site Batch" or Ready-Mix Vendor
  delivery_docket_no    String?           @db.VarChar(100)
  curing_tank_id        String?           @db.VarChar(50)
  notes                 String?           @db.Text
  created_at            DateTime          @default(now()) @db.Timestamptz

  project               Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  break_results         CubeBreakResult[]

  @@index([tenant_id, project_id, pour_date])
  @@map("concrete_cube_tests")
}

model CubeBreakResult {
  id                   String           @id @default(uuid()) @db.Uuid
  tenant_id            String           @db.Uuid
  cube_test_id         String           @db.Uuid
  cube_number          Int              // 1 to 6
  break_age_days       Int              // 7 or 28 (or 14)
  scheduled_break_date DateTime         @db.Date
  actual_break_date    DateTime?        @db.Date
  crushing_load_kn     Decimal?         @db.Decimal(8, 2) // Measured force in kN
  compressive_mpa      Decimal?         @db.Decimal(6, 2) // Load / (150mm * 150mm) = N/mm2 (MPa)
  is_pass              Boolean?
  lab_name             String?          @db.VarChar(255) // "Ministry of Works" or commercial lab
  certificate_key      String?          @db.VarChar(500) // S3 PDF storage key
  tested_by            String?          @db.VarChar(255)

  cube_test            ConcreteCubeTest @relation(fields: [cube_test_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, cube_test_id, scheduled_break_date])
  @@map("cube_break_results")
}

// =============================================================
// DOMAIN EXTENSION 4: HANDOVER & SNAGGING (PUNCH LIST)
// =============================================================

enum SnagSeverity {
  COSMETIC
  FUNCTIONAL
  CRITICAL_SAFETY
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RECTIFIED_BY_CONTRACTOR
  VERIFIED_CLOSED
  CONTESTED
}

model SnagItem {
  id                  String       @id @default(uuid()) @db.Uuid
  tenant_id           String       @db.Uuid
  project_id          String       @db.Uuid
  snag_number         Int          // Sequential per project
  location_block      String?      @db.VarChar(100) // e.g. "Block A"
  location_floor      String       @db.VarChar(100) // e.g. "2nd Floor"
  location_room       String       @db.VarChar(100) // e.g. "Apartment A3 - Master Bath"
  trade_category      String       @db.VarChar(100) // "Tiling", "Painting", "Plumbing", "Electrical", "Joinery"
  description         String       @db.Text
  severity            SnagSeverity @default(COSMETIC)
  status              SnagStatus   @default(OPEN)
  assigned_trade_firm String?      @db.VarChar(255) // Subcontractor or internal crew
  due_date            DateTime?    @db.Date
  identified_by_name  String       @db.VarChar(255) // Architect / Client / QS / PM
  identified_at       DateTime     @default(now()) @db.Timestamptz
  rectified_at        DateTime?    @db.Timestamptz
  verified_at         DateTime?    @db.Timestamptz
  verified_by_name    String?      @db.VarChar(255)

  project             Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  photos              SnagPhoto[]

  @@unique([project_id, snag_number])
  @@index([tenant_id, project_id, status])
  @@map("snag_items")
}

model SnagPhoto {
  id             String     @id @default(uuid()) @db.Uuid
  tenant_id      String     @db.Uuid
  snag_item_id   String     @db.Uuid
  photo_type     String     @db.VarChar(20) // "DEFECT" (before) or "RECTIFIED" (after)
  storage_key    String     @db.VarChar(500)
  caption        String?    @db.VarChar(255)
  gps_latitude   Decimal?   @db.Decimal(9, 6)
  gps_longitude  Decimal?   @db.Decimal(9, 6)
  captured_at    DateTime   @default(now()) @db.Timestamptz

  snag_item      SnagItem   @relation(fields: [snag_item_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, snag_item_id])
  @@map("snag_photos")
}

// =============================================================
// DOMAIN EXTENSION 5: DEFECTS LIABILITY & FINAL RETENTION CLOSEOUT
// =============================================================

enum CertificateType {
  PRACTICAL_COMPLETION
  MAKING_GOOD_DEFECTS
  FINAL_PAYMENT_CERTIFICATE
}

model DefectsLiabilityCertificate {
  id                      String          @id @default(uuid()) @db.Uuid
  tenant_id               String          @db.Uuid
  project_id              String          @db.Uuid
  certificate_type        CertificateType
  certificate_reference   String          @db.VarChar(100) // e.g. "CERT-PC-2026-001"
  issue_date              DateTime        @db.Date
  effective_date          DateTime        @db.Date
  dlp_duration_months     Int             @default(6) // Typically 6 months under JBC 1999
  dlp_expiry_date         DateTime?       @db.Date
  retention_amount_released Decimal       @db.Decimal(15, 2) // 50% moiety or final 50%
  architect_name          String          @db.VarChar(255)
  architect_boraqs_no     String?         @db.VarChar(50)
  qs_name                 String          @db.VarChar(255)
  qs_boraqs_no            String?         @db.VarChar(50)
  signed_certificate_key  String?         @db.VarChar(500) // S3 storage key of signed document
  notes                   String?         @db.Text
  created_at              DateTime        @default(now()) @db.Timestamptz

  project                 Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, certificate_type])
  @@map("defects_liability_certificates")
}

// =============================================================
// STAKEHOLDER PORTAL ACCESS LINKS (ZERO SEAT TAX)
// =============================================================

model PortalAccessLink {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  project_id       String    @db.Uuid
  portal_type      String    @db.VarChar(50) // "CLIENT", "CONSULTANT", "SUBCONTRACTOR", "SUPPLIER", "COMPLIANCE"
  stakeholder_name String    @db.VarChar(255)
  stakeholder_role String?   @db.VarChar(100) // e.g. "Architect", "Structural Engineer", "Electrical Subcontractor", "Ready-Mix Supplier", "NCA Compliance Officer"
  token            String    @unique @db.VarChar(255)
  is_active        Boolean   @default(true)
  expires_at       DateTime  @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz

  project          Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, portal_type])
  @@map("portal_access_links")
}

// =============================================================
// PROJECT SCHEDULE & GANTT TASKS (BUILD-SASA BENCHMARK)
// =============================================================

model ProjectScheduleTask {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  project_id           String    @db.Uuid
  wbs_phase            String    @db.VarChar(100) // "SUBSTRUCTURE", "SUPERSTRUCTURE", "ROOFING", "FINISHES", "SERVICES", "EXTERNAL_WORKS"
  task_name            String    @db.VarChar(255)
  description          String?   @db.Text
  planned_start_date   DateTime  @db.Date
  planned_end_date     DateTime  @db.Date
  actual_start_date    DateTime? @db.Date
  actual_end_date      DateTime? @db.Date
  duration_days        Int       @default(1)
  progress_percentage  Decimal   @default(0.00) @db.Decimal(5, 2)
  assigned_trade       String?   @db.VarChar(100) // "Masons", "Carpenters", "Steel Fixers", "Plumbers", "Electricians"
  status               String    @default("PLANNED") @db.VarChar(50) // "PLANNED", "IN_PROGRESS", "COMPLETED", "DELAYED"
  order_index          Int       @default(0)
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  project              Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, wbs_phase])
  @@map("project_schedule_tasks")
}

// =============================================================
// SITE STORE INVENTORY & STOCK BALANCES (BUILD-SASA BENCHMARK)
// =============================================================

model SiteInventoryItem {
  id                   String              @id @default(uuid()) @db.Uuid
  tenant_id            String              @db.Uuid
  project_id           String              @db.Uuid
  material_name        String              @db.VarChar(255) // e.g. "Simba Portland Cement 32.5N", "River Sand", "D12 High-Yield Rebar"
  category             String              @db.VarChar(100) // "CEMENT", "AGGREGATES", "STEEL", "MASONRY", "TIMBER", "PLUMBING", "ELECTRICAL"
  unit                 String              @db.VarChar(50) // "BAGS", "TONNES", "PIECES", "METRES", "LITRES"
  opening_balance      Decimal             @default(0.00) @db.Decimal(12, 4)
  current_stock        Decimal             @default(0.00) @db.Decimal(12, 4)
  minimum_reorder_level Decimal            @default(0.00) @db.Decimal(12, 4)
  unit_cost_estimate   Decimal?            @db.Decimal(15, 2)
  created_at           DateTime            @default(now()) @db.Timestamptz
  updated_at           DateTime            @updatedAt @db.Timestamptz

  project              Project             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  movements            InventoryMovement[]

  @@unique([project_id, material_name])
  @@index([tenant_id, project_id])
  @@map("site_inventory_items")
}

model InventoryMovement {
  id                   String            @id @default(uuid()) @db.Uuid
  tenant_id            String            @db.Uuid
  project_id           String            @db.Uuid
  inventory_item_id    String            @db.Uuid
  movement_type        String            @db.VarChar(50) // "DELIVERY_IN", "USAGE_OUT", "TRANSFER", "WASTAGE_DAMAGE"
  quantity             Decimal           @db.Decimal(12, 4)
  movement_date        DateTime          @db.Date
  reference_no         String?           @db.VarChar(100) // e.g. "DN-90124", "REQUISITION-014"
  notes                String?           @db.Text
  recorded_by_name     String            @db.VarChar(255)
  created_at           DateTime          @default(now()) @db.Timestamptz

  project              Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  item                 SiteInventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, inventory_item_id])
  @@map("inventory_movements")
}

// =============================================================
// SAFETY, HEALTH & ENVIRONMENTAL (HSE) INCIDENTS (OSHA 2007)
// =============================================================

model SafetyIncident {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  project_id           String    @db.Uuid
  incident_date        DateTime  @db.Date
  incident_time        String?   @db.VarChar(20) // e.g. "14:30"
  incident_type        String    @db.VarChar(50) // "NEAR_MISS", "FIRST_AID", "MEDICAL_TREATMENT", "LOST_TIME_INJURY", "PROPERTY_DAMAGE", "PPE_VIOLATION"
  severity             String    @db.VarChar(50) // "MINOR", "MODERATE", "SERIOUS", "CRITICAL"
  exact_location       String    @db.VarChar(255) // e.g. "Ground floor scaffold tower Grid B-3"
  affected_person_name String?   @db.VarChar(255)
  affected_trade       String?   @db.VarChar(100)
  description          String    @db.Text
  immediate_action     String?   @db.Text
  preventative_action  String?   @db.Text
  is_osha_reportable   Boolean   @default(false)
  investigated_by      String    @db.VarChar(255)
  created_at           DateTime  @default(now()) @db.Timestamptz

  project              Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, incident_type])
  @@map("safety_incidents")
}

// =============================================================
// PROJECT DOCUMENTS & DRAWINGS REPOSITORY (BUILD-SASA BENCHMARK)
// =============================================================

model ProjectDocument {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  project_id           String    @db.Uuid
  title                String    @db.VarChar(255)
  category             String    @db.VarChar(100) // "ARCHITECTURAL_DRAWING", "STRUCTURAL_DRAWING", "MEP_DRAWING", "COUNTY_APPROVAL_STAMP", "NEMA_LICENSE", "CONTRACT_AGREEMENT", "SPECIFICATION_SHEET"
  drawing_reference    String?   @db.VarChar(100) // e.g. "A-102", "S-201"
  revision_code        String    @default("Rev 0") @db.VarChar(50) // "Rev 0", "Rev A", "Rev B"
  storage_key          String    @db.VarChar(500)
  status               String    @default("APPROVED_FOR_CONSTRUCTION") @db.VarChar(50) // "APPROVED_FOR_CONSTRUCTION", "FOR_REVIEW", "SUPERSEDED", "INFORMATION_ONLY"
  uploaded_by_name     String    @db.VarChar(255)
  notes                String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamptz

  project              Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, category])
  @@map("project_documents")
}

// =============================================================
// SUBCONTRACTOR WORK PACKAGES & DIRECTORY (BUILD-SASA BENCHMARK)
// =============================================================

model SubcontractorPackage {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  project_id           String    @db.Uuid
  trade_category       String    @db.VarChar(100) // "PLUMBING", "ELECTRICAL", "ROOFING", "TILING", "PAINTING", "GLAZING", "HVAC"
  firm_name            String    @db.VarChar(255)
  contact_person       String?   @db.VarChar(255)
  phone_number         String?   @db.VarChar(50)
  subcontract_sum      Decimal   @db.Decimal(15, 2)
  retention_rate_pct   Decimal   @default(5.00) @db.Decimal(5, 2) // Typically 5% or 10% under Kenyan subcontracts
  status               String    @default("ACTIVE") @db.VarChar(50) // "AWARDED", "ACTIVE", "COMPLETED", "TERMINATED"
  scope_description    String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  project              Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, project_id, trade_category])
  @@map("subcontractor_packages")
}

