  supplier_name              String         @db.VarChar(255) // "Bamburi Special Products", "Rhombus Concrete", "Savannah RMC"
  truck_registration_no      String         @db.VarChar(50)  // "KDH 482B", "KDA 918M"
  driver_name                String?        @db.VarChar(255)
  driver_phone               String?        @db.VarChar(50)
  concrete_class             String         @db.VarChar(50)  // "CLASS_25_20", "CLASS_30_20", "CLASS_35_20", "CLASS_40_20"
  ordered_volume_m3          Decimal        @db.Decimal(8, 2) // e.g. 7.50 m3
  dispatched_at              DateTime       @db.Timestamptz
  arrived_at                 DateTime?      @db.Timestamptz
  discharge_started_at       DateTime?      @db.Timestamptz
  discharge_completed_at     DateTime?      @db.Timestamptz
