  cubes_cast_batch_no        String?          @db.VarChar(100) // Link to concrete cube test batch BT-xxx
  tested_by_inspector        String           @db.VarChar(255)
  qa_verdict                 String           @default("ACCEPTED") @db.VarChar(30) // "ACCEPTED", "REJECTED"
  created_at                 DateTime         @default(now()) @db.Timestamptz
  updated_at                 DateTime         @updatedAt @db.Timestamptz

  delivery                   RmcBatchDelivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  tenant                     Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, delivery_id])
  @@map("rmc_slump_tests")
}

