model RmcSlumpTest {
  id                         String           @id @default(uuid()) @db.Uuid
  tenant_id                  String           @db.Uuid
  delivery_id                String           @db.Uuid
  test_time                  DateTime         @default(now()) @db.Timestamptz
  specified_slump_mm         Int              @default(100) // e.g. 100mm target
  measured_slump_mm          Int              // e.g. 110mm
