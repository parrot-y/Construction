  severity                   String                @default("WARNING") @db.VarChar(20) // "INFO", "WARNING", "CRITICAL", "FATAL_SHUTDOWN"
  dtc_code                   String?               @db.VarChar(20)
  title                      String                @db.VarChar(255)
  description                String                @db.Text
