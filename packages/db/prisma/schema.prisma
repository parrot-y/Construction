  maintenance_alerts               PlantMaintenanceAlert[]

  @@index([tenant_id, status])
  @@index([tenant_id, project_id])
  @@map("plant_telematics_devices")
}

model PlantTelematicsPing {
  id                         String                @id @default(uuid()) @db.Uuid
  tenant_id                  String                @db.Uuid
  device_id                  String                @db.Uuid
  equipment_id               String                @db.Uuid
  ping_timestamp             DateTime              @default(now()) @db.Timestamptz
  latitude                   Decimal               @db.Decimal(9, 6)
  longitude                  Decimal               @db.Decimal(9, 6)
  engine_status              String                @default("RUNNING") @db.VarChar(20) // "RUNNING", "IDLE", "STOPPED"
  engine_rpm                 Int?
  coolant_temp_c             Decimal?              @db.Decimal(5, 1) // PID 0x05
  oil_temp_c                 Decimal?              @db.Decimal(5, 1) // PID 0x5C
  fuel_rate_l_per_h          Decimal?              @db.Decimal(6, 2) // PID 0x5E
  engine_load_percent        Decimal?              @db.Decimal(5, 2) // PID 0x04
  speed_kmh                  Decimal?              @db.Decimal(5, 1) // PID 0x0D
  battery_voltage            Decimal?              @db.Decimal(4, 2) // Supply voltage
  dtc_fault_codes            String?               @db.VarChar(255) // E.g. "P0300,P0115"
  cumulative_engine_seconds  BigInt                @default(0)
  fuel_level_percent         Decimal               @db.Decimal(5, 2)
  calculated_fuel_liters     Decimal               @db.Decimal(8, 2)
  fuel_drop_liters           Decimal?              @db.Decimal(8, 2)
  drop_rate_l_per_hour       Decimal?              @db.Decimal(8, 2)
  is_siphoning_event         Boolean               @default(false)
  anomaly_severity           String?               @db.VarChar(20) // "NONE", "LOW", "HIGH", "CRITICAL"
  created_at                 DateTime              @default(now()) @db.Timestamptz

  telematics_device          PlantTelematicsDevice @relation(fields: [device_id], references: [id], onDelete: Cascade)
  equipment                  PlantEquipment        @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
  tenant                     Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([device_id, ping_timestamp(sort: Desc)])
  @@index([equipment_id, ping_timestamp(sort: Desc)])
  @@index([tenant_id, equipment_id, is_siphoning_event])
  @@map("plant_telematics_pings")
}

model PlantMaintenanceAlert {
