  pour_location_element      String         @db.VarChar(255) // "Zone B 3rd Floor Suspended Slab Beams B1-B14"
  status                     String         @default("IN_TRANSIT") @db.VarChar(50) // "IN_TRANSIT", "ARRIVED", "POURING", "COMPLETED", "REJECTED_COLD_JOINT_RISK"
