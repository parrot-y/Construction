model PlantTelematicsDevice {
  id                               String                 @id @default(uuid()) @db.Uuid
  tenant_id                        String                 @db.Uuid
  project_id                       String?                @db.Uuid
  equipment_id                     String                 @unique @db.Uuid
  device_imei                      String                 @unique @db.VarChar(50)
  device_token                     String?                @unique @db.VarChar(100) // Secret bearer token for IoT webhook authentication
  protocol                         String                 @default("CANBUS") @db.VarChar(50) // "OBD2", "CANBUS", "GPS_MODEM", "MODBUS_FLOW"
  can_bus_baud_rate                Int                    @default(250000) // 250kbps (J1939) or 500kbps (OBD2)
  max_engine_burn_rate_lph         Decimal                @default(35.00) @db.Decimal(6, 2) // Engine physical max burn rate
  sim_phone_number                 String?                @db.VarChar(50)
  calibration_tank_capacity_liters Decimal                @default(300.00) @db.Decimal(8, 2)
  tank_geometry                    String                 @default("RECTANGULAR") @db.VarChar(50)
  status                           String                 @default("ONLINE") @db.VarChar(50) // "ONLINE", "OFFLINE", "FAULT"
  last_heartbeat_at                DateTime?              @db.Timestamptz
  created_at                       DateTime               @default(now()) @db.Timestamptz
  updated_at                       DateTime               @updatedAt @db.Timestamptz

  equipment                        PlantEquipment         @relation(fields: [equipment_id], references: [id], onDelete: Cascade)
  tenant                           Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  project                          Project?               @relation(fields: [project_id], references: [id], onDelete: SetNull)
