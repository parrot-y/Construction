# MjengoLedger — Production Environment Configuration
# Copy to .env in your hosting environment (Railway / Render / AWS)

# Fastify API Server
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://app.mjengoledger.co.ke

# PostgreSQL Database (with Row-Level Security)
# Runtime role: Must be non-superuser, non-owner 'db_app'
DATABASE_URL=postgresql://db_app:CHANGE_ME_IN_PRODUCTION@postgres.railway.internal:5432/construction?schema=public

# Migration role (used only during deployment: prisma migrate deploy)
DATABASE_MIGRATION_URL=postgresql://db_migrator:CHANGE_ME_IN_PRODUCTION@postgres.railway.internal:5432/construction?schema=public

# Security & Authentication
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_PRODUCTION
COOKIE_SECRET=GENERATE_64_CHAR_HEX_SECRET_FOR_COOKIES

# Storage (AWS S3 or Cloudflare R2 for receipt & photo attachments)
STORAGE_BUCKET_NAME=mjengo-ledger-prod
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Safaricom Daraja 2.0 M-Pesa Subscription Billing (Milestone M22)
MPESA_ENVIRONMENT=sandbox # Set to 'live' for production Safaricom Daraja API
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://api.mjengoledger.co.ke/api/v1/billing/mpesa-callback

# Twilio / Africa's Talking WhatsApp & SMS Gateway (Milestone M20)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# KRA e-TIMS VSCU Electronic Invoicing Integration (Milestone M19)
KRA_ETIMS_ENDPOINT=https://timsvscu.kra.go.ke
KRA_ETIMS_PIN=
KRA_ETIMS_DEVICE_SERIAL=

# IoT Plant Telematics & CANBUS Flow Meters (Milestone M24)
TELEMATICS_SHARED_SECRET=GENERATE_32_CHAR_SECRET_FOR_IOT_GATEWAY
